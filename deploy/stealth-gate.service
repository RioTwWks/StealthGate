[Unit]
Description=StealthGate MTProto proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stealthgate
Group=stealthgate
WorkingDirectory=/opt/stealth-gate
ExecStart=/opt/stealth-gate/bin/stealth-gate --config /etc/stealth-gate/config.toml
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info
# Пароль первого admin WebUI (опционально)
# Environment=STEALTHGATE_ADMIN_PASSWORD=...

# Hardening (NoNewPrivileges отключён: иначе setcap и AmbientCapabilities не дают bind на :443)
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stealth-gate/data /tmp
PrivateTmp=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
